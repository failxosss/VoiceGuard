<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cz.voiceguard</groupId>
    <artifactId>VoiceGuard</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>VoiceGuard</name>
    <description>Voice chat moderation plugin for Paper using Simple Voice Chat + Vosk offline speech recognition</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Match this to the Simple Voice Chat version installed on the target server. -->
        <voicechat.api.version>2.5.28</voicechat.api.version>
        <paper.api.version>1.21.4-R0.1-SNAPSHOT</paper.api.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>

        <!-- Official Simple Voice Chat / opus4j repository (henkelmax) -->
        <repository>
            <id>henkelmax-public</id>
            <url>https://maven.maxhenkel.de/repository/public</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API - provided by the server at runtime -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Simple Voice Chat plugin API - provided by the Simple Voice Chat plugin at runtime -->
        <dependency>
            <groupId>de.maxhenkel.voicechat</groupId>
            <artifactId>voicechat-api</artifactId>
            <version>${voicechat.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
            Opus decoding.
            IMPORTANT: On the Bukkit/Paper build of Simple Voice Chat, VoicechatApi#createDecoder()
            has no natives bundled and returns null (this is documented behaviour, not a bug in
            VoiceGuard). We therefore ship our own Opus decoder via opus4j - the same native Opus
            wrapper Simple Voice Chat itself uses - instead of relying on the (unavailable) API decoder.
            This is shaded into the final jar so server owners only need one file.
        -->
        <dependency>
            <groupId>de.maxhenkel.opus4j</groupId>
            <artifactId>opus4j</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Offline speech-to-text -->
        <dependency>
            <groupId>com.alphacephei</groupId>
            <artifactId>vosk</artifactId>
            <version>0.3.45</version>
        </dependency>

        <!-- Local violation database -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VoiceGuard-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
                Shade opus4j, vosk and sqlite-jdbc (incl. native libs) into the final jar so the
                server only needs Simple Voice Chat + VoiceGuard.jar, nothing else.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <relocations>
                                <relocation>
                                    <pattern>de.maxhenkel.opus4j</pattern>
                                    <shadedPattern>cz.voiceguard.libs.opus4j</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.xerial.sqlitejdbc</pattern>
                                    <shadedPattern>cz.voiceguard.libs.sqlitejdbc</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>
</project>
